# Что НЕ должно попадать в контекст сборки (= в образ).
# Контекст передаётся демону Docker по сети при сборке, поэтому всё лишнее
# здесь — это лишние мегабайты и минуты на сервере (а иногда и утечка секретов).

# Секреты: .env читает docker compose на хосте, внутри образа он не нужен
.env
.env.*

# Локальные данные: сессии (auth*.json), логи, debug-дампы попыток, metrics.jsonl
# В контейнер этот каталог попадает как volume (./data:/data), а не копированием.
data/

# Локальное окружение и мусор
.venv/
venv/
__pycache__/
*.pyc
.git/
.gitignore
.vscode/
.DS_Store

# Документация внутри образа не нужна
*.md
