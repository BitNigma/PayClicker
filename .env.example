# Шаблон окружения: скопируйте в .env и заполните.
#   cp .env.example .env        (Windows: copy .env.example .env)
# .env в git не коммитится — там ваши пароли и живая сессия сайта.

# --- Telegram ---
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Кто может управлять ботом. Свой id можно узнать, отправив боту команду /id
TELEGRAM_ALLOWED_CHAT_ID=111111111
# Можно несколько админов: через запятую/пробел/;. Работают и имена
# TELEGRAM_ADMIN_IDS / TELEGRAM_SUB_USERS / SUB_USER.
# TELEGRAM_ADMIN_IDS=111111111,222222222

# --- Учётные данные личного кабинета №1 ---
SITE_LOGIN=first@example.com
SITE_PASSWORD=пароль

# Человекочитаемое имя кабинета — фигурирует в /status и в префиксах
# уведомлений: [Имя] ✅ Взята заявка #123
SITE_NAME=Кабинет 1

SITE_URL=https://spark-trading.cash/signin
QUEUE_URL=https://spark-trading.cash/payouts
DEMANDS_URL=https://spark-trading.cash/demands

# --- Дополнительные кабинеты (мультиаккаунт) ---
# Кабинет 2 и дальше описываются переменными с суффиксом _2, _3, ...
# Номер кабинета — это то, что потом указывают в Telegram (/run -> бот спросит номер).
# Обе переменные (логин И пароль) обязательны для каждого кабинета; SITE_NAME_N опционален.
# У каждого кабинета свой файл сессии: auth.json (кабинет 1), auth_2.json, auth_3.json...
SITE_LOGIN_2=second@example.com
SITE_PASSWORD_2=пароль2
SITE_NAME_2=Кабинет 2
# SITE_LOGIN_3=
# SITE_PASSWORD_3=
# SITE_NAME_3=

# --- Поведение ---
# Сколько заявок держать в активной очереди
TARGET_QUEUE_SIZE=10

# Частота опроса в режиме watch (наблюдение), мс
RELOAD_MIN_MS=1000
RELOAD_MAX_MS=2500

# Частота опроса в режиме take (реальное взятие заявок), мс.
# ГЛАВНЫЙ рычаг задержки обнаружения: цикл опроса ≈ RTT запроса + эта пауза.
# Опрос АКТИВЕН всегда (и с предиктивом тоже): он находит реальные заявки,
# обновляет якорь/CSRF и служит подстраховкой, а предиктив лишь ДОБАВЛЯЕТ отправки
# на будущие id. Итоговая частота опроса = 1/пауза × TAKE_PARALLEL_POLLERS.
TAKE_POLL_MIN_MS=60
TAKE_POLL_MAX_MS=140

# Сколько независимых воронок одновременно опрашивают очередь (на ОДИН кабинет).
# Больше воронок -> меньше окно обнаружения, но выше нагрузка на сайт.
# Ограничивается до 1 ТОЛЬКО если вы явно включили «редкий» режим опроса
# (PREDICTIVE_TAKE_POLL_MS>0) — иначе работают все воронки.
TAKE_PARALLEL_POLLERS=2

# Повтор POST take_payout, если ответ сервера НЕОДНОЗНАЧНЫЙ: заявка ещё в очереди
# (still_available) или ответ не распознан (unknown) и взятие не подтвердилось.
# «Взяли»/«уже забрали» (taken/gone) НЕ повторяются. Повтор — только для РЕАЛЬНЫХ
# (не предсказанных) взятий, чтобы не устраивать POST-шторм. 0 — без повторов.
TAKE_RETRY_COUNT=2
# Пауза между повторными POST, мс.
TAKE_RETRY_DELAY_MS=120

# false — показывать браузер (удобно для подбора селекторов)
HEADLESS=false

# Складывать ли в каталог данных HTML/PNG-дампы каждой попытки взятия
# (пригодится, если на сервере «что-то не так» и нужно посмотреть разметку).
# На постоянно работающем сервере дампы копятся: чистите их ./deploy.sh prune
DEBUG_CAPTURE_ATTEMPTS=true

# Отладочные сообщения в Telegram: HTML/PNG-дампы страниц и подробные сводки
# очереди (📊/🔄/🧹). DEBUG=false — бот не спамит, шлёт только важное: взятые
# заявки, ошибки, блокировки, 2FA. Дампы всё равно пишутся локально в ./data.
DEBUG=true

# Как часто (сек) бот сверяется со страницей DEMANDS_URL — истиной о занятых слотах.
# По ней считается размер активной очереди: в неё входят и взятые нами заявки, и
# выданные площадкой автоматически, и оставшиеся с прошлого запуска процесса.
# Меньше — точнее счёт после автовыдачи/завершения заявок, но больше запросов.
DEMANDS_SYNC_S=10

# --- Горячий цикл (без браузера) ---
# http (по умолчанию) — опрос/взятие заявок через httpx, браузер только для логина;
# browser — прежний Playwright-воркер (при 2+ кабинетах работает только кабинет №1)
WORKER_BACKEND=http

# Таймаут HTTP-запроса, сек
HTTP_TIMEOUT_S=10

# Сколько раз подряд бот может сбросить cookies кабинета и авторизоваться заново,
# если сайт блокирует HTTP-клиент (403/антибот, Cloudflare). Ограничение, чтобы не
# зациклиться на устойчивом блоке.
BLOCK_REAUTH_ATTEMPTS=3

# --- Прокси (оперативная смена IP при бане) ---
# Прокси для HTTP-цикла И браузерной авторизации. При 403/антиботе бот СНАЧАЛА
# меняет IP (прокси), НЕ трогая cookies; сброс cookies/реавторизация — только если
# все прокси перебраны. Пусто — работаем напрямую (как раньше).
# Форматы: http://host:port, http://user:pass@host:port, socks5://user:pass@host:port
# PROXY_URLS=http://user:pass@1.2.3.4:8080,http://5.6.7.8:3128
# Файл со списком (по одному на строку, `#` — комментарий). ПЕРЕЧИТЫВАЕТСЯ на лету
# при каждой смене IP — можно дописывать/убирать прокси без перезапуска бота.
# PROXY_FILE=./data/proxies.txt
# Менять прокси при блокировке (true) или сразу сбрасывать cookies (false).
PROXY_ROTATE_ON_BLOCK=true

# --- Превентивное (предсказательное) взятие ---
# ID заявок на площадке идут по порядку. Поймав id текущей заявки (взяли или
# упустили), бот сразу отправляет take_payout на следующие PREDICTIVE_TAKE_COUNT
# id, не дожидаясь их появления в HTML очереди — так он выигрывает гонку.
# Если всё окно оказалось неудачным, бот берёт САМЫЙ БОЛЬШИЙ id окна и шлёт
# следующее окно от него, и так далее (поиск вперёд), пока не поймает заявку.
#
# Сколько id прибавлять к пойманному за раз: за пару секунд очередь улетает
# вперёд примерно на 25 номеров. Ограничивать себя не нужно — площадка всё
# равно не даст держать в работе больше своего лимита (≈10), остальные запросы
# просто не подтвердятся.
PREDICTIVE_TAKE=false
PREDICTIVE_TAKE_COUNT=25
# Пауза между окнами поиска, мс (чтобы не превращаться в бесконечный шторм POST).
PREDICTIVE_TAKE_GAP_MS=300
# На сколько id разрешено забегать вперёд от последнего РЕАЛЬНО увиденного в
# очереди id. Дойдя до предела, поиск НЕ встаёт ждать, а ВОЗВРАЩАЕТСЯ к якорю и
# заново обстреливает тот же диапазон (retry): id, который пробовали до появления
# заявки, пробуется снова — иначе заявка теряется («прочёс вперёд» = одна попытка
# на id). 0 — без ограничения (шагать вперёд без повторов).
# Больше значение = шире «сеть» под уже проскочившие id; меньше = ближе к очереди.
PREDICTIVE_TAKE_LOOKAHEAD=200
# ОПЦИОНАЛЬНО. Своя пауза GET очереди, мс (джиттер до +50%).
#   0 (по умолчанию)     — активный горячий цикл: TAKE_POLL_MIN/MAX_MS, все воронки.
#   меньше TAKE_POLL_MAX — ещё агрессивнее (напр. 1 = почти без паузы), воронки все.
#   больше TAKE_POLL_MAX — «тихий» режим: редкий опрос, воронка одна (ниже риск
#                          Cloudflare; заявки компенсирует predict_loop). Ориентир 800–1500.
# PREDICTIVE_TAKE_POLL_MS=800
# Писать в ./data отдельные дампы и по предсказанным POST (имя `..._pred.json`).
# По умолчанию выключено: предсказаний много, и большинство не подтвердится.
# Для отладки предсказателя — включите true.
# PREDICTIVE_TAKE_DUMPS=false
#
# Видимость предсказательных POST (чтобы не казалось, что их нет):
#   • в логе — строка «🔮 превентивно: окно #a…#b — N POST take_payout»;
#   • в Telegram — при DEBUG=true «🔮 Превентивно: N POST take_payout (окно #a…#b,
#     якорь #c)»: ОДИН раз на каждый новый реально увиденный id (якорь), не чаще ~3с.
#     Так видно, что предиктив жив, но одно и то же сообщение не повторяется каждые
#     3 секунды (раньше дублировалось, пока очередь стоит на месте);
#   • в ./data/metrics.jsonl — записи take/take_result с полем `"predicted": true`
#     (у таких записей poll_rtt_ms/parse_ms = null — они не из GET).
# Защита от «убегания вперёд» (встроена, настраивать не нужно):
#   • предсказанные отправки НЕ считаются занятыми слотами — опрос реальной
#     очереди не «слепнет» во время пачки предсказаний;
#   • при полной реальной очереди предсказатель ждёт (не бежит вперёд);
#   • если реальность обогнала курсор — курсор догоняет её.
# ВНИМАНИЕ: это дополнительная POST-нагрузка (часть запросов — по ещё не
# существующим id). Включайте осознанно, особенно с учётом антибота Cloudflare.

# --- Разбор тела ответа на POST take_payout (диагностика) ---
# Бот смотрит в ответ сервера, чтобы в уведомлении объяснить РЕЗУЛЬТАТ взятия:
# «взяли», «такой заявки нет / её забрали», «заявка ещё в очереди». Это лишь
# пояснение — саму заявку бот по-прежнему подтверждает по странице demands.
# Формулировки у площадки могут отличаться, поэтому маркеры задаются здесь.
# Каждое значение — через запятую; сравнение без учёта регистра.
# Пример (заполните под реальные ответы сайта; по умолчанию пусто):
# TAKE_SUCCESS_MARKERS=заявка успешно взята,успешно
# TAKE_GONE_MARKERS=заявка не найдена,уже взята,уже забрана
TAKE_SUCCESS_MARKERS=
TAKE_GONE_MARKERS=

# Куда писать замеры времени (по умолчанию рядом с логом -> ./data/metrics.jsonl)
# METRICS_PATH=./data/metrics.jsonl

# --- Пути (для локального запуска; в Docker переопределяются в docker-compose.yml) ---
STORAGE_STATE_PATH=./data/auth.json
LOG_PATH=./data/actions.log

# --- Docker на сервере (см. README → «Деплой на Hostinger») ---
# Часовой пояс контейнера: время в логах и в замерах metrics.jsonl.
# Если не задано, docker-compose.yml берёт Europe/Moscow.
# TZ=Europe/Moscow

# Каталог на хосте, монтируемый в контейнер как /data (сессия, логи, дампы).
# По умолчанию — ./data рядом с docker-compose.yml.
# DATA_DIR=./data
